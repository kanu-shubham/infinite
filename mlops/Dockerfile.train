# Training image – heavier than the serving image because it needs
# MLflow, scipy, etc. Not deployed to production.
FROM python:3.11-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY config.yaml .
COPY src/ src/

ENV PYTHONPATH=/app
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# models/ and data/ are mounted as volumes so artifacts survive the container
CMD ["python", "-m", "src.train"]
