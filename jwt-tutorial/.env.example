# Copy to .env and fill in real values. Never commit .env.

# Secret for HS256. Must be long & random (>= 32 bytes). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_me_with_a_long_random_string

# Algorithm: HS256 (shared secret) or RS256 (public/private key pair).
# Use RS256 when multiple services need to verify tokens but only one signs.
JWT_ALG=HS256

# Token lifetimes
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# In production: set NODE_ENV=production and serve behind HTTPS.
# Cookies in this app are `Secure` whenever NODE_ENV=production.
NODE_ENV=development
PORT=3001
