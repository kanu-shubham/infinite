# Optimization 2 (stacked on top of APC): Chunked Prefill.
# Long prompts are sliced into prefill chunks that interleave with the
# decode steps of already-running requests. This is what stops a single
# long prompt from pausing the token stream of every other in-flight
# request -- critical when prompt and decode requests share a server.
MODEL=Qwen/Qwen2.5-1.5B-Instruct
DTYPE=bfloat16
MAX_MODEL_LEN=8192
GPU_MEMORY_UTILIZATION=0.90

ENABLE_PREFIX_CACHING=true
ENABLE_CHUNKED_PREFILL=true

# With chunked prefill, lower the per-step batched-token budget so each
# step contains a manageable mix of prefill chunks + decode tokens.
# 2048 is a common starting point on a single GPU.
MAX_NUM_BATCHED_TOKENS=2048
MAX_NUM_SEQS=256

MAX_INFLIGHT=192
MAX_QUEUE=64
REQUEST_TIMEOUT_S=120
MAX_OUTPUT_TOKENS=1024
LOG_LEVEL=INFO
