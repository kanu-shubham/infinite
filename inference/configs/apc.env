# Optimization 1: Automatic Prefix Caching (APC).
# Repeated shared prefixes (system prompts, few-shot exemplars, RAG
# headers) skip prefill by reusing already-computed KV blocks. This is
# the infrastructure-side analog of Claude's prompt caching feature.
MODEL=Qwen/Qwen2.5-1.5B-Instruct
DTYPE=bfloat16
MAX_MODEL_LEN=8192
GPU_MEMORY_UTILIZATION=0.90

ENABLE_PREFIX_CACHING=true
ENABLE_CHUNKED_PREFILL=false

MAX_NUM_BATCHED_TOKENS=8192
MAX_NUM_SEQS=256

MAX_INFLIGHT=192
MAX_QUEUE=64
REQUEST_TIMEOUT_S=120
MAX_OUTPUT_TOKENS=1024
LOG_LEVEL=INFO
