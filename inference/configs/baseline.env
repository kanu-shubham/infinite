# Baseline: continuous batching only (vLLM default), no prefix cache,
# no chunked prefill. This is the reference point for the deltas table.
MODEL=Qwen/Qwen2.5-1.5B-Instruct
DTYPE=bfloat16
MAX_MODEL_LEN=8192
GPU_MEMORY_UTILIZATION=0.90

ENABLE_PREFIX_CACHING=false
ENABLE_CHUNKED_PREFILL=false

# Scheduler: defaults that are friendly to a 24GB GPU.
MAX_NUM_BATCHED_TOKENS=8192
MAX_NUM_SEQS=256

MAX_INFLIGHT=192
MAX_QUEUE=64
REQUEST_TIMEOUT_S=120
MAX_OUTPUT_TOKENS=1024
LOG_LEVEL=INFO
