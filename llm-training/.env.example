# Copy to .env and fill in. Never commit .env.

# Hugging Face
HF_TOKEN=
HF_HOME=./hf_cache
TRANSFORMERS_CACHE=./hf_cache

# Weights & Biases (optional — set WANDB_MODE=disabled to turn off)
WANDB_API_KEY=
WANDB_PROJECT=llm-train
WANDB_MODE=online

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Torch / CUDA
CUDA_VISIBLE_DEVICES=0
TOKENIZERS_PARALLELISM=false
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
